model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-ES
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["data","Posicion","Seleccion","Club"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table data
ref table Posicion
ref table Seleccion
ref table Club
ref table Medidas
ref table Nacimiento

ref cultureInfo es-ES

